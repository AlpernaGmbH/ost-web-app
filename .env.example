# Supabase (Project Settings -> API). The publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used exclusively by the daily iCal cron job. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (any long random string).
CRON_SECRET=

# Shared secret for POST /api/import/exercises (operator import of exercise files, "Authorization: Bearer <IMPORT_SECRET>").
# Any long random string; without it the endpoint refuses every request.
IMPORT_SECRET=

# WhatsApp number behind "Zugang anfragen" on the landing page (/anfrage redirects to a chat), international format, e.g. +41 79 000 00 00.
# Server only and never printed on a page. Without it the endpoint answers 503 and points to the Impressum address.
WHATSAPP_NUMBER=

# Exercises from uploaded PDFs (Claude, Message Batches API). Server only. Without the key the feature is shown as "not set up".
# Console key from https://platform.claude.com (separate from a Claude subscription); costs are billed per token.
ANTHROPIC_API_KEY=
# Hard monthly spending limits in USD (defaults: 10 for the whole deployment, 5 per account). A run that would exceed them is refused.
AI_MONTHLY_CAP_USD=10
AI_USER_MONTHLY_CAP_USD=5
