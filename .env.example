# Supabase (Project Settings -> API). The publishable key is safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Used exclusively by the daily iCal cron job. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>" (any long random string).
CRON_SECRET=

# Shared secret for POST /api/import/exercises (operator import of exercise files, "Authorization: Bearer <IMPORT_SECRET>").
# Any long random string; without it the endpoint refuses every request.
IMPORT_SECRET=
